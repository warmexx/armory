<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\..\FrameXML\UI.xsd">
  <!--
    Classic keeps Blizzard's own templates, which look like Classic. Shared XML uses the names
    of Armory's Mainline templates, so here they point to Blizzard's.
  -->
  <Button name="ArmoryUIPanelButtonTemplate" inherits="UIPanelButtonTemplate" virtual="true"/>
  <Button name="ArmoryUIPanelCloseButton" inherits="UIPanelCloseButton" virtual="true"/>
  <EditBox name="ArmoryInputBoxTemplate" inherits="InputBoxTemplate" virtual="true"/>
  <Frame name="ArmoryDialogBorderDarkTemplate" inherits="DialogBorderDarkTemplate" virtual="true"/>
  <Frame name="ArmoryButtonFrameTemplate" inherits="ButtonFrameTemplate" virtual="true"/>
  <Frame name="ArmoryInsetFrameTemplate" inherits="InsetFrameTemplate" useParentLevel="true" virtual="true"/>
  <Frame name="ArmoryChildFrameTemplate" movable="true" parent="ArmoryFrame" inherits="ButtonFrameTemplate" enableMouse="true" virtual="true">
    <Anchors>
      <Anchor point="TOPLEFT" relativeTo="ArmoryFrame" relativePoint="TOPRIGHT" x="42"/>
    </Anchors>
    <HitRectInsets>
      <AbsInset left="0" right="34" top="0" bottom="75"/>
    </HitRectInsets>
  </Frame>
  <EditBox name="ArmorySearchBoxTemplate" inherits="SearchBoxTemplate" virtual="true"/>
  <CheckButton name="ArmoryUICheckButtonTemplate" inherits="UICheckButtonTemplate" virtual="true"/>
  <ScrollFrame name="ArmoryUIPanelScrollFrameTemplate" inherits="UIPanelScrollFrameTemplate" virtual="true"/>
  <ScrollFrame name="ArmoryFauxScrollFrameTemplate" inherits="FauxScrollFrameTemplate" virtual="true"/>
  <!-- The same for the functions of those templates that shared Lua and XML call -->
  <Script>
    ArmorySearchBoxTemplate_OnTextChanged = SearchBoxTemplate_OnTextChanged;
    ArmorySmallMoneyFrame_OnLoad = SmallMoneyFrame_OnLoad;
    ArmoryMoneyFrame_SetType = MoneyFrame_SetType;
    ArmoryMoneyFrame_SetMaxDisplayWidth = MoneyFrame_SetMaxDisplayWidth;
  </Script>
</Ui>
