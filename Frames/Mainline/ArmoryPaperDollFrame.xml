<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\..\FrameXML\UI.xsd">
  <Frame name="ArmoryPaperDollFrame" setAllPoints="true" parent="ArmoryFrame" useParentLevel="true" id="1">
    <Layers>
      <Layer level="OVERLAY">
        <FontString name="ArmoryVersionText" inherits="ArmoryFontHighlightExtraSmall" text="version">
          <Anchors>
            <Anchor point="BOTTOMLEFT" relativeTo="ArmoryFrameInset">
              <Offset>
                <AbsDimension x="6" y="6"/>
              </Offset>
            </Anchor>
          </Anchors>
        </FontString>
        <FontString name="ArmoryNewVersionText" inherits="ArmoryFontHighlightExtraSmall" text="new version" hidden="true">
          <Anchors>
            <Anchor point="BOTTOMLEFT" relativeTo="ArmoryVersionText" relativePoint="TOPLEFT">
              <Offset>
                <AbsDimension x="0" y="3"/>
              </Offset>
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <Frame name="ArmoryPaperDollHeaderFrame" useParentLevel="true">
        <Anchors>
          <Anchor point="TOPLEFT" x="30" y="-26"/>
          <Anchor point="BOTTOMRIGHT" relativeTo="ArmoryFrameInset" relativePoint="TOPRIGHT"/>
        </Anchors>
        <Layers>
          <Layer level="OVERLAY">
            <FontString name="ArmoryLevelText" inherits="GameFontNormalSmall" text="Level level race class">
              <Size x="240" y="0"/>
              <Anchors>
                <Anchor point="TOP" />
              </Anchors>
            </FontString>
            <FontString name="ArmoryGuildText" inherits="GameFontNormalSmall" text="title of guild" hidden="true">
              <Size x="245" y="0"/>
              <Anchors>
                <Anchor point="TOP" relativeTo="ArmoryLevelText" relativePoint="BOTTOM" x="0" y="-1"/>
              </Anchors>
            </FontString>
            <FontString name="ArmoryZoneText" inherits="GameFontNormalSmall" text="zone of the player">
              <Size x="255" y="0"/>
              <Anchors>
                <Anchor point="TOP" relativeTo="ArmoryGuildText" relativePoint="BOTTOM" x="0" y="-1"/>
              </Anchors>
            </FontString>
          </Layer>
        </Layers>
      </Frame>
      <Frame name="ArmoryPaperDollTalent" inherits="ArmoryPaperDollTalentFrameTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="ArmoryFrameInset">
            <Offset>
              <AbsDimension x="47" y="-4"/>
            </Offset>
          </Anchor>
        </Anchors>
      </Frame>
      <Frame name="ArmoryPaperDollTradeSkill" inherits="ArmoryPaperDollTradeSkillFrameTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="ArmoryPaperDollTalent" relativePoint="BOTTOMLEFT">
            <Offset>
              <AbsDimension x="0" y="0"/>
            </Offset>
          </Anchor>
        </Anchors>
      </Frame>
      <Frame name="ArmorySocketsFrame" inherits="ArmorySocketsFrameTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="ArmoryPaperDollTalent" relativePoint="TOPRIGHT">
            <Offset x="0" y="0"/>
          </Anchor>
        </Anchors>
      </Frame>
      <Frame name="ArmoryAttributesFrame" inherits="ArmoryAttributesFrameTemplate">
        <Size>
          <AbsDimension x="228" y="125"/>
        </Size>
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="ArmoryPaperDollTradeSkill" relativePoint="BOTTOMLEFT">
            <Offset>
              <AbsDimension x="2" y="-25"/>
            </Offset>
          </Anchor>
        </Anchors>
        <Frames>
          <Frame name="ArmoryAttributesFramePlayerStatDropDown" inherits="ArmoryDropDownMenuTemplate" enableMouse="true">
            <Anchors>
              <Anchor point="BOTTOMLEFT" relativeTo="ArmoryAttributesFrameTop" relativePoint="TOPLEFT">
                <Offset>
                  <AbsDimension x="-17" y="-8"/>
                </Offset>
              </Anchor>
            </Anchors>
            <Scripts>
              <OnLoad function="ArmoryAttributesFramePlayerStatDropDown_OnLoad" />
              <OnShow function="ArmoryAttributesFramePlayerStatDropDown_OnLoad" />
            </Scripts>
          </Frame>
        </Frames>
      </Frame>
      <Frame name="ArmoryPaperDollItemsFrame" setAllPoints="true">
        <Frames>
          <Button name="ArmoryHeadSlot" inherits="ArmoryPaperDollItemSlotButtonLeftTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryFrameInset" x="4" y="-2"/>
            </Anchors>
          </Button>
          <Button name="ArmoryNeckSlot" inherits="ArmoryPaperDollItemSlotButtonLeftTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryHeadSlot" relativePoint="BOTTOMLEFT"  x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryShoulderSlot" inherits="ArmoryPaperDollItemSlotButtonLeftTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryNeckSlot" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryBackSlot" inherits="ArmoryPaperDollItemSlotButtonLeftTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryShoulderSlot" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryChestSlot" inherits="ArmoryPaperDollItemSlotButtonLeftTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryBackSlot" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryShirtSlot" inherits="ArmoryPaperDollItemSlotButtonLeftTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryChestSlot" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryTabardSlot" inherits="ArmoryPaperDollItemSlotButtonLeftTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryShirtSlot" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryWristSlot" inherits="ArmoryPaperDollItemSlotButtonLeftTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryTabardSlot" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryHandsSlot" inherits="ArmoryPaperDollItemSlotButtonRightTemplate">
            <Anchors>
              <Anchor point="TOPRIGHT" relativeTo="ArmoryFrameInset" x="-4" y="-2"/>
            </Anchors>
          </Button>
          <Button name="ArmoryWaistSlot" inherits="ArmoryPaperDollItemSlotButtonRightTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryHandsSlot" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryLegsSlot" inherits="ArmoryPaperDollItemSlotButtonRightTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryWaistSlot" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryFeetSlot" inherits="ArmoryPaperDollItemSlotButtonRightTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryLegsSlot" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryFinger0Slot" inherits="ArmoryPaperDollItemSlotButtonRightTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryFeetSlot" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryFinger1Slot" inherits="ArmoryPaperDollItemSlotButtonRightTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryFinger0Slot" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryTrinket0Slot" inherits="ArmoryPaperDollItemSlotButtonRightTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryFinger1Slot" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryTrinket1Slot" inherits="ArmoryPaperDollItemSlotButtonRightTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryTrinket0Slot" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
            </Anchors>
          </Button>
          <Button name="ArmoryMainHandSlot" inherits="ArmoryPaperDollItemSlotButtonBottomTemplate">
            <Anchors>
              <Anchor point="BOTTOMLEFT" x="130" y="16"/>
            </Anchors>
            <Layers>
              <Layer level="BACKGROUND">
                <Texture inherits="Char-Slot-Bottom-Left">
                  <Anchors>
                    <Anchor point="TOPRIGHT" relativeTo="$parentFrame" relativePoint="TOPLEFT"/>
                  </Anchors>
                </Texture>
              </Layer>
            </Layers>
          </Button>
          <Button name="ArmorySecondaryHandSlot" inherits="ArmoryPaperDollItemSlotButtonBottomTemplate">
            <Anchors>
              <Anchor point="TOPLEFT" relativeTo="ArmoryMainHandSlot" relativePoint="TOPRIGHT" x="5" y="0"/>
            </Anchors>
            <Layers>
              <Layer level="BACKGROUND">
                <Texture inherits="Char-Slot-Bottom-Right">
                  <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentFrame" relativePoint="TOPRIGHT"/>
                  </Anchors>
                </Texture>
              </Layer>
            </Layers>
          </Button>
        </Frames>
      </Frame>

      <Frame name="ArmoryAlternateSlotFrame"  hidden="true">
        <Size x="64" y="64" />
        <Scripts>
          <OnUpdate>
            ArmoryAlternateSlotFrame_OnUpdate(self, elapsed);
          </OnUpdate>
        </Scripts>
      </Frame>
      <Button name="ArmoryGearSetToggleButton" hidden="true">
        <Size x="32" y="32"/>
        <Anchors>
          <Anchor point="TOPRIGHT" x="-5" y="-27"/>
        </Anchors>
        <Scripts>
          <OnShow>
            ArmoryPaperDollHeaderFrame:SetPoint("TOPLEFT", ArmoryFrame, "TOPLEFT", 35, -26);
          </OnShow>
          <OnHide>
            ArmoryPaperDollHeaderFrame:SetPoint("TOPLEFT", ArmoryFrame, "TOPLEFT", 55, -26);
          </OnHide>
          <OnEnter>
            GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
            GameTooltip:SetText(EQUIPMENT_MANAGER);
          </OnEnter>
          <OnLeave>
            GameTooltip:Hide();
          </OnLeave>
          <OnLoad>
            self.icon = _G[self:GetName() .. "Icon"];
          </OnLoad>
          <OnClick>
            if ( ArmoryGearSetFrame:IsShown() ) then
              ArmoryGearSetFrame:Hide();
            else
              ArmoryGearSetFrame:Show();
            end
          </OnClick>
        </Scripts>
        <NormalTexture file="Interface\PaperDollInfoFrame\UI-GearManager-Button"/>
        <PushedTexture file="Interface\PaperDollInfoFrame\UI-GearManager-Button-Pushed"/>
        <HighlightTexture file="Interface\Buttons\UI-MicroButton-Hilight" alphaMode="ADD">
          <TexCoords left="0" right="1" top="0.390625" bottom="0.96875"/>
        </HighlightTexture>
      </Button>
    </Frames>
    <Scripts>
      <OnLoad>
        ArmoryPaperDollFrame_OnLoad(self);
      </OnLoad>
      <OnEvent>
        ArmoryPaperDollFrame_OnEvent(self, event, ...);
      </OnEvent>
      <OnShow>
        ArmoryPaperDollFrame_OnShow(self);
        -- UpdateUIPanelPositions(ArmoryFrame);
      </OnShow>
      <OnHide>
        ArmoryBuffFrame_RemoveBuffs("player");
      </OnHide>
    </Scripts>
  </Frame>

</Ui>