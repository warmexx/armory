<!-- Revision: @file-revision@ @file-date-iso@ -->
<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\FrameXML\UI.xsd">
  <Script file="ArmoryPVPFrame.lua"/>

  <!-- Blizzard's HonorFrameTemplates.xml of Classic, which Forever does not load -->
  <Frame name="ArmoryHonorFrameTextButtonTemplate" enableMouse="true" virtual="true">
    <Size x="278" y="12"/>
    <Layers>
      <Layer level="BACKGROUND">
        <FontString name="$parentText" parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Anchors>
            <Anchor point="TOPLEFT"/>
          </Anchors>
        </FontString>
        <FontString name="$parentValue" parentKey="Value" inherits="GameFontNormalSmall">
          <Anchors>
            <Anchor point="RIGHT" relativePoint="LEFT" x="278" y="1"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Scripts>
      <OnEnter function="ArmoryHonorFrameTextButton_OnEnter"/>
      <OnLeave function="GameTooltip_Hide"/>
    </Scripts>
  </Frame>
  <Frame name="ArmoryHonorFrameHKButtonTemplate" inherits="ArmoryHonorFrameTextButtonTemplate" virtual="true">
    <Scripts>
      <OnLoad>
        ArmoryHonorFrameTextButton_OnLoad(self, HONORABLE_KILLS, NEWBIE_TOOLTIP_HONORABLE_KILLS, GREEN_FONT_COLOR);
      </OnLoad>
    </Scripts>
  </Frame>
  <Frame name="ArmoryHonorFrameDKButtonTemplate" inherits="ArmoryHonorFrameTextButtonTemplate" virtual="true">
    <Scripts>
      <OnLoad>
        ArmoryHonorFrameTextButton_OnLoad(self, DISHONORABLE_KILLS, NEWBIE_TOOLTIP_DISHONORABLE_KILLS, RED_FONT_COLOR);
      </OnLoad>
    </Scripts>
  </Frame>
  <Frame name="ArmoryHonorFrameRankButtonTemplate" inherits="ArmoryHonorFrameTextButtonTemplate" virtual="true">
    <Scripts>
      <OnLoad>
        ArmoryHonorFrameTextButton_OnLoad(self, HONOR_HIGHEST_RANK or RANK, NEWBIE_TOOLTIP_RANK);
      </OnLoad>
    </Scripts>
  </Frame>

  <Frame name="ArmoryPVPFrame" setAllPoints="true" enableMouse="true" movable="true" parent="ArmoryFrame" useParentLevel="true" hidden="true" id="4">
    <Anchors>
      <Anchor point="TOPLEFT" x="-14" y="14"/>
      <Anchor point="BOTTOMRIGHT" />
    </Anchors>
    <HitRectInsets>
      <AbsInset left="0" right="30" top="0" bottom="75"/>
    </HitRectInsets>
    <Layers>
      <Layer level="ARTWORK">
        <Texture file="Interface\PaperDollInfoFrame\UI-Character-Honor-TopLeft">
          <Size x="256" y="256"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="22" y="-69"/>
          </Anchors>
        </Texture>
        <Texture file="Interface\PaperDollInfoFrame\UI-Character-Honor-TopRight">
          <Size x="128" y="256"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="275" y="-69"/>
          </Anchors>
        </Texture>
        <Texture file="Interface\PaperDollInfoFrame\UI-Character-Honor-BottomLeft">
          <Size x="256" y="128"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="22" y="-325"/>
          </Anchors>
        </Texture>
        <Texture file="Interface\PaperDollInfoFrame\UI-Character-Honor-BottomRight">
          <Size x="128" y="128"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="275" y="-325"/>
          </Anchors>
        </Texture>
        <FontString name="ArmoryHonorFrameCurrentPVPTitle" inherits="GameFontNormal">
          <Anchors>
            <Anchor point="TOP" x="0" y="-87"/>
          </Anchors>
        </FontString>
        <FontString name="ArmoryHonorFrameCurrentPVPRank" inherits="GameFontNormalSmall">
          <Anchors>
            <Anchor point="LEFT" relativeTo="ArmoryHonorFrameCurrentPVPTitle" relativePoint="RIGHT" x="5" y="-1"/>
          </Anchors>
        </FontString>
        <FontString name="ArmoryHonorFrameCurrentSessionTitle" inherits="GameFontNormal" text="HONOR_THIS_SESSION">
          <Anchors>
            <Anchor point="TOPLEFT" x="36" y="-112"/>
          </Anchors>
        </FontString>
        <FontString name="ArmoryHonorFrameYesterdayTitle" inherits="GameFontNormal" text="HONOR_YESTERDAY">
          <Anchors>
            <Anchor point="TOPLEFT" relativeTo="ArmoryHonorFrameCurrentSessionTitle" relativePoint="BOTTOMLEFT" x="0" y="-41"/>
          </Anchors>
        </FontString>
        <!-- This week in Era -->
        <FontString name="ArmoryHonorFrameSeasonTitle" inherits="GameFontNormal">
          <Anchors>
            <Anchor point="TOPLEFT" relativeTo="ArmoryHonorFrameYesterdayTitle" relativePoint="BOTTOMLEFT" x="0" y="-43"/>
          </Anchors>
        </FontString>
        <!-- Last week in Era -->
        <FontString name="ArmoryHonorFrameHonorTitle" inherits="GameFontNormal">
          <Anchors>
            <Anchor point="TOPLEFT" relativeTo="ArmoryHonorFrameSeasonTitle" relativePoint="BOTTOMLEFT" x="0" y="-42"/>
          </Anchors>
        </FontString>
        <FontString name="ArmoryHonorFrameLifeTimeTitle" inherits="GameFontNormal" text="HONOR_LIFETIME">
          <Anchors>
            <Anchor point="TOPLEFT" relativeTo="ArmoryHonorFrameHonorTitle" relativePoint="BOTTOMLEFT" x="0" y="-64"/>
          </Anchors>
        </FontString>
      </Layer>
      <Layer level="OVERLAY">
        <Texture name="ArmoryHonorFramePvPIcon">
          <Size x="24" y="24"/>
          <Anchors>
            <Anchor point="RIGHT" relativeTo="ArmoryHonorFrameCurrentPVPTitle" relativePoint="LEFT" x="-5" y="0"/>
          </Anchors>
        </Texture>
      </Layer>
    </Layers>
    <Frames>
      <Frame name="ArmoryHonorFrameCurrentHK" inherits="ArmoryHonorFrameHKButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="ArmoryHonorFrameCurrentSessionTitle" relativePoint="BOTTOMLEFT" x="10" y="-3"/>
        </Anchors>
      </Frame>
      <Frame name="ArmoryHonorFrameCurrentDK" inherits="ArmoryHonorFrameDKButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="ArmoryHonorFrameCurrentHK" relativePoint="BOTTOMLEFT" x="0" y="-2"/>
        </Anchors>
      </Frame>
      <Frame name="ArmoryHonorFrameYesterdayHK" inherits="ArmoryHonorFrameHKButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="ArmoryHonorFrameYesterdayTitle" relativePoint="BOTTOMLEFT" x="10" y="-3"/>
        </Anchors>
      </Frame>
      <Frame name="ArmoryHonorFrameYesterdayDK" inherits="ArmoryHonorFrameDKButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="ArmoryHonorFrameYesterdayHK" relativePoint="BOTTOMLEFT" x="0" y="-3"/>
        </Anchors>
      </Frame>
      <Frame name="ArmoryHonorFrameSeasonProgress" inherits="ArmoryHonorFrameTextButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="ArmoryHonorFrameSeasonTitle" relativePoint="BOTTOMLEFT" x="10" y="-3"/>
        </Anchors>
      </Frame>
      <Frame name="ArmoryHonorFrameSeasonCap" inherits="ArmoryHonorFrameTextButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="ArmoryHonorFrameSeasonProgress" relativePoint="BOTTOMLEFT" x="0" y="-3"/>
        </Anchors>
      </Frame>
      <Frame name="ArmoryHonorFrameHonorPoints" inherits="ArmoryHonorFrameTextButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="ArmoryHonorFrameHonorTitle" relativePoint="BOTTOMLEFT" x="10" y="-3"/>
        </Anchors>
      </Frame>
      <Frame name="ArmoryHonorFrameLifeTimeHK" inherits="ArmoryHonorFrameHKButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="ArmoryHonorFrameLifeTimeTitle" relativePoint="BOTTOMLEFT" x="10" y="-4"/>
        </Anchors>
      </Frame>
      <Frame name="ArmoryHonorFrameLifeTimeRank" inherits="ArmoryHonorFrameRankButtonTemplate">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="ArmoryHonorFrameLifeTimeHK" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
        </Anchors>
      </Frame>
      <Frame name="ArmoryHonorFrameRankButton" enableMouse="true" hidden="false">
        <Size x="10" y="24"/>
        <Anchors>
          <Anchor point="LEFT" relativeTo="ArmoryHonorFramePvPIcon"/>
          <Anchor point="RIGHT" relativeTo="ArmoryHonorFrameCurrentPVPRank"/>
        </Anchors>
        <Scripts>
          <OnEnter function="ArmoryHonorFrameRankButton_OnEnter"/>
          <OnLeave function="GameTooltip_Hide"/>
        </Scripts>
      </Frame>
      <StatusBar name="ArmoryHonorFrameProgressBar" drawLayer="BORDER" minValue="0" maxValue="1" defaultValue="0">
        <Size x="315" y="29"/>
        <Anchors>
          <Anchor point="TOPLEFT" x="22" y="-77"/>
        </Anchors>
        <Frames>
          <Frame name="ArmoryHonorFrameProgressButton" enableMouse="true" setAllPoints="true">
            <Scripts>
              <OnLoad function="LowerFrameLevel"/>
              <OnEnter function="ArmoryHonorFrameProgressButton_OnEnter"/>
              <OnLeave function="GameTooltip_Hide"/>
            </Scripts>
          </Frame>
        </Frames>
        <Scripts>
          <OnLoad function="LowerFrameLevel"/>
        </Scripts>
        <BarTexture name="$parentBar" file="Interface\PaperDollInfoFrame\UI-Character-Skills-Bar" />
      </StatusBar>
    </Frames>
    <Scripts>
      <OnLoad>
        ArmoryPVPFrame_OnLoad(self);
      </OnLoad>
      <OnEvent>
        ArmoryPVPFrame_OnEvent(self, event, ...);
      </OnEvent>
      <OnShow>
        ArmoryPVPFrame_Update();
      </OnShow>
      <OnMouseUp>
        ArmoryFrame_OnMouseUp(self, button);
      </OnMouseUp>
      <OnMouseDown>
        ArmoryFrame_OnMouseDown(self, button);
      </OnMouseDown>
      <OnMouseWheel>
        return;
      </OnMouseWheel>
    </Scripts>
  </Frame>
</Ui>
